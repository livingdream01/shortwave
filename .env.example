# Shortwave — environment variables
# Copy to .env.local. The app runs in DEMO MODE when the required keys are absent.

# DeepSeek (agent brain) — OpenAI-compatible
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_THINK=deepseek-reasoner
DEEPSEEK_MODEL_FAST=deepseek-chat

# Supabase (database + public storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=shortwave

# fal.ai (video + image)
FAL_KEY=

# Replicate (video fallback, optional)
REPLICATE_API_TOKEN=

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# OpenAI Whisper (captions, optional — falls back to estimated timings)
OPENAI_API_KEY=

# Instagram / Meta app
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=http://localhost:3040/api/oauth/instagram
IG_GRAPH_HOST=https://graph.instagram.com
IG_API_VERSION=v23.0

# App
NEXT_PUBLIC_APP_URL=http://localhost:3040
